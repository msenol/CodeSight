# CodeSight MCP Server - Production Dockerfile
# Based on Distroless for maximum security

# Stage 1: Build application
FROM node:20-bookworm-slim AS builder

WORKDIR /build

# Copy package files first for better caching
COPY typescript-mcp/package*.json ./typescript-mcp/

# Install production dependencies
RUN cd typescript-mcp && npm ci --omit=dev

# Copy application source and build
COPY typescript-mcp/ ./typescript-mcp/
RUN cd typescript-mcp && npm run build 2>/dev/null || echo "Using pre-built dist"

# Stage 2: Prepare optional Rust FFI
FROM alpine:3.19 AS rust-builder

WORKDIR /build
COPY . ./project/
RUN mkdir -p ./lib && \
    if [ -f ./project/rust-core/target/release/libcode_intelligence_core.so ]; then \
        cp ./project/rust-core/target/release/libcode_intelligence_core.so ./lib/; \
    fi

# Stage 3: Production image
FROM gcr.io/distroless/nodejs20-debian12

LABEL maintainer="CodeSight Team"
LABEL version="0.1.0"
LABEL description="CodeSight MCP Server - Production"

# Security labels
LABEL org.opencontainers.image.source="https://github.com/msenol/CodeSight"
LABEL org.opencontainers.image.vendor="CodeSight"

WORKDIR /app

# Copy built application from builder
COPY --from=builder /build/typescript-mcp/dist ./dist
COPY --from=builder /build/typescript-mcp/node_modules ./node_modules
COPY --from=builder /build/typescript-mcp/package.json ./

# Copy Rust FFI from rust-builder (if built)
COPY --from=rust-builder /build/lib/ ./lib/

# Copy entrypoint
COPY docker/entrypoint-prod.sh ./entrypoint.sh

# Non-root user
USER nobody

EXPOSE 4000 8080

ENV NODE_ENV=production
ENV LOG_LEVEL=info
ENV NODE_OPTIONS="--max-old-space-size=2048"

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node dist/health-check.js || exit 1

ENTRYPOINT ["./entrypoint.sh"]
CMD ["hybrid"]
