#!/usr/bin/env sh

echo "🔒 Running pre-commit checks..."

# Get staged file lists
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
STAGED_RUST=$(echo "$STAGED_FILES" | grep -E "\.rs$" || true)
STAGED_TS=$(echo "$STAGED_FILES" | grep -E "\.(ts|tsx)$" || true)

# ─── Security Checks ───────────────────────────────────────────────

# Check for .mcp.json files
if echo "$STAGED_FILES" | grep -q "\.mcp\.json"; then
  echo "❌ .mcp.json should not be committed (contains API keys)"
  exit 1
fi

# Check for .env files (except .env.example)
STAGED_ENVS=$(echo "$STAGED_FILES" | grep -E "^\.env$|\.env\.local$|\.env\..*\.local$" || true)
if [ -n "$STAGED_ENVS" ]; then
  echo "❌ .env files should not be committed"
  echo "   Files: $STAGED_ENVS"
  exit 1
fi

# Scan staged content for secrets
echo "🔍 Scanning for secrets..."
STAGED_DIFF=$(git diff --cached --diff-filter=ACM -U0)

if echo "$STAGED_DIFF" | grep -qE '^\+.*(OPENROUTER_API_KEY|OPENAI_API_KEY|ANTHROPIC_API_KEY|GROQ_API_KEY)\s*=\s*['\''"][a-zA-Z0-9_-]{20,}'; then
  echo "❌ Hardcoded API key detected in staged changes"
  exit 1
fi

if echo "$STAGED_DIFF" | grep -qE '^\+.*sk-or-v1-[a-zA-Z0-9]{20,}'; then
  echo "❌ OpenRouter API key detected in staged changes"
  exit 1
fi

if echo "$STAGED_DIFF" | grep -qE '^\+.*sk-ant-[a-zA-Z0-9]{20,}'; then
  echo "❌ Anthropic API key detected in staged changes"
  exit 1
fi

if echo "$STAGED_DIFF" | grep -qE '^\+.*sk-[a-zA-Z0-9]{20,}'; then
  echo "❌ OpenAI API key detected in staged changes"
  exit 1
fi

if echo "$STAGED_DIFF" | grep -qE '^\+.*ghp_[a-zA-Z0-9]{36}'; then
  echo "❌ GitHub token detected in staged changes"
  exit 1
fi

if echo "$STAGED_DIFF" | grep -qE '^\+.*-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----'; then
  echo "❌ Private key detected in staged changes"
  exit 1
fi

echo "✅ No secrets detected"

# ─── Rust Checks (only if .rs files changed) ───────────────────────

if [ -n "$STAGED_RUST" ]; then
  echo "🦀 Running Rust checks..."

  # cargo fmt
  cd rust-core
  if ! cargo fmt --check 2>/dev/null; then
    echo "❌ Rust formatting failed. Run: cd rust-core && cargo fmt"
    exit 1
  fi

  # cargo clippy
  if ! cargo clippy --all-targets --all-features -- -D warnings 2>/dev/null; then
    echo "❌ Clippy warnings found. Run: cd rust-core && cargo clippy --fix --all-targets --all-features"
    exit 1
  fi

  cd ..
  echo "✅ Rust checks passed"
fi

# ─── TypeScript Checks (only if .ts/.tsx files changed) ─────────────

if [ -n "$STAGED_TS" ]; then
  echo "📘 Running TypeScript checks..."

  cd typescript-mcp

  # TypeScript type check
  if ! npx tsc --noEmit 2>/dev/null; then
    echo "❌ TypeScript type check failed. Run: cd typescript-mcp && npx tsc --noEmit"
    exit 1
  fi

  # ESLint
  if ! npx eslint src --quiet 2>/dev/null; then
    echo "❌ ESLint errors found. Run: cd typescript-mcp && npx eslint src --fix"
    exit 1
  fi

  cd ..
  echo "✅ TypeScript checks passed"
fi

echo "✅ All pre-commit checks passed"
exit 0
